[
  {
    "name": "Infrastructure problems",
    "matchedStatuses": ["broken", "failed"],
    "messageRegex": ".*(\\b429\\b|Retry-After|ConnectTimeout|ConnectionError|RetryError|Max retries exceeded|too many \\d+ error responses).*"
  },
  {
    "name": "Contract drift (schema or model mismatch)",
    "matchedStatuses": ["broken", "failed"],
    "messageRegex": ".*(ValidationError|jsonschema|KeyError).*"
  },
  {
    "name": "Product defects",
    "matchedStatuses": ["failed"]
  },
  {
    "name": "Test defects",
    "matchedStatuses": ["broken"]
  },
  {
    "name": "Skipped tests",
    "matchedStatuses": ["skipped"]
  }
]
